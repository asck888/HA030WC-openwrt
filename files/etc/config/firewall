# HA030WC AP 模式 - 防火墙（极简）
# AP 只有一个 lan 桥，没有 wan，不需要 NAT/转发，全部放行即可。

config defaults
	option input 'ACCEPT'
	option output 'ACCEPT'
	option forward 'ACCEPT'
	option synflood_protect '1'

config zone
	option name 'lan'
	option input 'ACCEPT'
	option output 'ACCEPT'
	option forward 'ACCEPT'
	option network 'lan'
